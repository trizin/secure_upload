# Copy to .env and edit. Both hostnames must point at this host before the
# first start, or Caddy cannot obtain certificates.
SUPLOAD_APP_HOST=supload.org
SUPLOAD_FILE_HOST=files.supload.org
SUPLOAD_ACME_EMAIL=admin@supload.org

# Optional
#SUPLOAD_MAX_FILE_SIZE=104857600
#SUPLOAD_TOTAL_QUOTA=21474836480
#SUPLOAD_RETENTION=172800
#SUPLOAD_ABUSE_EMAIL=abuse@supload.org
